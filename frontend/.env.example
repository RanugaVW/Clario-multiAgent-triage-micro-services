# Voice-to-text microservice (services/voice-to-text-service).
# Used when the browser has no working Web Speech API, or when Chrome's
# speech service fails and dictation falls back to our own Whisper service.
NEXT_PUBLIC_VOICE_SERVICE_URL=http://127.0.0.1:8002
# Optional: only set this if the WebSocket lives somewhere other than
# <NEXT_PUBLIC_VOICE_SERVICE_URL>/ws/transcribe (e.g. behind a TLS proxy).
# NEXT_PUBLIC_VOICE_WS_URL=ws://127.0.0.1:8002/ws/transcribe
